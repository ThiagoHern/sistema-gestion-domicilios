          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/domiciliarios" }
        },
        {
          "name": "Listar Establecimientos Aliados",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/establecimientos" }
        }
      ]
