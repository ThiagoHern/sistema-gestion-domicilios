    "name": "Sistema de Gestión de Domicilios - Cali (UAO)",
    "description": "Colección completa de pruebas REST para el Proyecto Integrador de Bases de Datos 1 (Spring Boot + MySQL 8).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
