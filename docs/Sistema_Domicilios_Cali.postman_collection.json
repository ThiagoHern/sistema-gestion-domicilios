      "item": [
        {
          "name": "[RN-03] Rechazar recogida doble (aliado + externa)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('Rechazo por exclusividad de origen', () => pm.expect(pm.response.json().ok).to.eql(false));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"numeroIdentificacionCliente\": \"1001\",\n  \"idDireccion\": 1,\n  \"descripcionRecogida\": \"Prueba doble origen\",\n  \"metodoPago\": \"efectivo\",\n  \"montoTotal\": 20000,\n  \"codigoEstablecimiento\": 101,\n  \"ubicacionRecogidaExterna\": \"Calle 10 # 5-10\",\n  \"idBarrioRecogidaExterna\": 1\n}" },
            "url": "{{baseUrl}}/api/solicitudes"
          }
        },
        {
          "name": "[RN-03] Rechazar recogida nula (sin aliado ni externa)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('Rechazo por falta de origen', () => pm.expect(pm.response.json().ok).to.eql(false));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"numeroIdentificacionCliente\": \"1001\",\n  \"idDireccion\": 1,\n  \"descripcionRecogida\": \"Prueba sin origen\",\n  \"metodoPago\": \"efectivo\",\n  \"montoTotal\": 20000\n}" },
            "url": "{{baseUrl}}/api/solicitudes"
          }
        },
        {
          "name": "[RN-04] Rechazar dirección ajena al cliente",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('Mensaje indica dirección ajena', () => pm.expect(pm.response.json().mensaje).to.include('no pertenece al cliente'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"numeroIdentificacionCliente\": \"1001\",\n  \"idDireccion\": 3,\n  \"descripcionRecogida\": \"Direccion de otro cliente\",\n  \"metodoPago\": \"efectivo\",\n  \"montoTotal\": 25000,\n  \"codigoEstablecimiento\": 101\n}" },
            "url": "{{baseUrl}}/api/solicitudes"
          }
        },
        {
          "name": "[RN-05] Rechazar asignación a domiciliario inactivo (#3)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('Mensaje indica domiciliario inactivo', () => pm.expect(pm.response.json().mensaje).to.include('inactivo'));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"codigoDomiciliario\": 3\n}" },
            "url": "{{baseUrl}}/api/solicitudes/506/asignar"
          }
        },
        {
          "name": "[Trigger] Rechazar incidente con fecha anterior a creación",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('Trigger bloqueó la fecha inválida', () => pm.expect(pm.response.json().mensaje).to.include('anterior'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"numeroSolicitud\": 501,\n  \"tipoIncidente\": \"retraso\",\n  \"fechaHoraIncidente\": \"2020-01-01T08:00:00\",\n  \"descripcion\": \"Fecha anterior imposible\"\n}" },
            "url": "{{baseUrl}}/api/incidentes"
          }
        },
        {
          "name": "[RN-06] Rechazar transición inválida (finalizar solicitud creada)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
            "pm.test('SP rechazó salto de estado', () => pm.expect(pm.response.json().ok).to.eql(false));"
          ]}}],
          "request": {
