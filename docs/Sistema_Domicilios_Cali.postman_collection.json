    {
      "name": "3. Ciclo de Vida de Solicitudes (SP ACID)",
      "item": [
        {
          "name": "Listar Solicitudes (con tarifa SQL e incidentes)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "const arr = pm.response.json();",
            "pm.test('Incluye campo tarifaDomicilio', () => pm.expect(arr[0]).to.have.property('tarifaDomicilio'));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/solicitudes" }
        },
        {
          "name": "Crear Solicitud en Establecimiento Aliado (sp_registrar_solicitud)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
            "const json = pm.response.json();",
            "pm.test('Solicitud creada exitosamente', () => pm.expect(json.ok).to.eql(true));",
            "if (json.numeroSolicitud) pm.collectionVariables.set('solicitudCreadaId', json.numeroSolicitud);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"numeroIdentificacionCliente\": \"1001\",\n  \"idDireccion\": 1,\n  \"descripcionRecogida\": \"Almuerzo ejecutivo #4582\",\n  \"metodoPago\": \"efectivo\",\n  \"montoTotal\": 42000,\n  \"codigoEstablecimiento\": 101,\n  \"ubicacionRecogidaExterna\": null,\n  \"idBarrioRecogidaExterna\": null\n}" },
            "url": "{{baseUrl}}/api/solicitudes"
          }
        },
        {
          "name": "Crear Solicitud con Recogida Externa (sp_registrar_solicitud)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
            "pm.test('Solicitud externa creada', () => pm.expect(pm.response.json().ok).to.eql(true));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"numeroIdentificacionCliente\": \"1002\",\n  \"idDireccion\": 3,\n  \"descripcionRecogida\": \"Paquete de documentos urgentes\",\n  \"metodoPago\": \"electrónico\",\n  \"montoTotal\": 90000,\n  \"codigoEstablecimiento\": null,\n  \"ubicacionRecogidaExterna\": \"Calle 5 # 38-25\",\n  \"idBarrioRecogidaExterna\": 1\n}" },
            "url": "{{baseUrl}}/api/solicitudes"
          }
        },
        {
          "name": "Consultar Detalle de Solicitud",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Incluye lista de incidentes', () => pm.expect(pm.response.json().incidentes).to.be.an('array'));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/solicitudes/{{solicitudCreadaId}}" }
        },
        {
          "name": "Asignar Domiciliario Activo #1 (sp_asignar_domiciliario)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Asignación exitosa', () => pm.expect(pm.response.json().ok).to.eql(true));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"codigoDomiciliario\": 1\n}" },
            "url": "{{baseUrl}}/api/solicitudes/{{solicitudCreadaId}}/asignar"
          }
        },
        {
          "name": "Cambiar Estado a 'en curso' (sp_actualizar_estado_solicitud)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Estado actualizado a en curso', () => pm.expect(pm.response.json().ok).to.eql(true));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"en curso\"\n}" },
            "url": "{{baseUrl}}/api/solicitudes/{{solicitudCreadaId}}/estado"
          }
        },
        {
          "name": "Cambiar Estado a 'finalizada' (sp_actualizar_estado_solicitud)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Estado actualizado a finalizada', () => pm.expect(pm.response.json().ok).to.eql(true));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"finalizada\"\n}" },
            "url": "{{baseUrl}}/api/solicitudes/{{solicitudCreadaId}}/estado"
          }
        }
      ]
    },
