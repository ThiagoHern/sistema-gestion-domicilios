  ],
  "item": [
    {
      "name": "1. Salud y Catálogos",
      "item": [
        {
          "name": "Health Check MySQL + Spring Boot",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('MySQL conectado', () => pm.expect(pm.response.json().ok).to.eql(true));"
            ]}
          }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
        },
        {
          "name": "Obtener todos los catálogos",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Contiene barrios, clientes, domiciliarios y establecimientos', () => {",
              "  pm.expect(json).to.have.property('barrios');",
              "  pm.expect(json).to.have.property('clientes');",
              "  pm.expect(json).to.have.property('domiciliarios');",
              "  pm.expect(json).to.have.property('establecimientos');",
              "});"
            ]}
          }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/catalogos" }
        }
      ]
    },
    {
      "name": "2. Entidades (Clientes, Direcciones, Domiciliarios, Aliados)",
      "item": [
        {
          "name": "Listar Clientes",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Lista es un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/clientes" }
        },
        {
          "name": "Crear Cliente + Dirección Inicial",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201 Created o 409 si ya existe', () => pm.expect([201, 409]).to.include(pm.response.code));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"numeroIdentificacion\": \"1099\",\n  \"nombres\": \"Valentina\",\n  \"apellidoPaterno\": \"Ríos\",\n  \"apellidoMaterno\": \"Salazar\",\n  \"telefono\": \"3119998877\",\n  \"correoElectronico\": \"valentina.rios@example.com\",\n  \"ubicacion\": \"Calle 16 # 85-20\",\n  \"idBarrio\": 2,\n  \"referenciaAdicional\": \"Conjunto El Ingenio\"\n}" },
            "url": "{{baseUrl}}/api/clientes"
          }
        },
        {
          "name": "Agregar Dirección a Cliente (RN-02)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201 Created', () => pm.response.to.have.status(201));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"numeroIdentificacionCliente\": \"1001\",\n  \"ubicacion\": \"Avenida Roosevelt # 25-40\",\n  \"idBarrio\": 1,\n  \"referenciaAdicional\": \"Oficina 202\"\n}" },
            "url": "{{baseUrl}}/api/direcciones"
          }
        },
        {
          "name": "Listar Domiciliarios",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
